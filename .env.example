# Server
PORT=5000
NODE_ENV=development

# Database — Must be a MongoDB Replica Set URI (required for ACID transactions)
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/banking?retryWrites=true&w=majority

# JWT — Use a long, random secret in production
JWT_SECRET=change_me_to_a_very_long_random_secret_string
JWT_EXPIRES_IN=7d

# Frontend URL (for CORS)
CLIENT_URL=http://localhost:5173
