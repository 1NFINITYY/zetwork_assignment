PORT=5000
NODE_ENV=development

# ⚠️  REQUIRED: Replace with your MongoDB Atlas connection string
# MongoDB Atlas provides replica set support needed for ACID transactions.
# Get it from: https://cloud.mongodb.com → Connect → Drivers
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/banking?retryWrites=true&w=majority

# ⚠️  REQUIRED: Replace with a long random secret
JWT_SECRET=replace_me_with_a_very_long_random_secret_at_least_32_characters
JWT_EXPIRES_IN=7d

# Frontend URL(s) for CORS. Change in production.
# Multiple Vercel URLs: comma-separated, no spaces
# CLIENT_URL=https://app-git-master-xyz.vercel.app,https://app-abc.vercel.app
CLIENT_URL=http://localhost:5173
