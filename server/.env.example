PORT=5000
NODE_ENV=development

# ⚠️  REQUIRED: Replace with your MongoDB Atlas connection string
# MongoDB Atlas provides replica set support needed for ACID transactions.
# Get it from: https://cloud.mongodb.com → Connect → Drivers
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/banking?retryWrites=true&w=majority

# ⚠️  REQUIRED: Replace with a long random secret
JWT_SECRET=replace_me_with_a_very_long_random_secret_at_least_32_characters
JWT_EXPIRES_IN=7d

# Frontend URL (for CORS). Change in production.
CLIENT_URL=http://localhost:5173

# Your Render deployment URL — used by the self-ping keep-alive to prevent
# the free-tier service from sleeping after 15 minutes of inactivity.
# Render sets this automatically in the runtime environment, OR you can set it manually.
# Example: https://your-app-name.onrender.com
RENDER_EXTERNAL_URL=https://your-app-name.onrender.com
